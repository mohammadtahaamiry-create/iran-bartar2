# Database (SQLite)
# Use absolute path on the server for persistence
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Settings encryption key (used by src/lib/settings.ts)
# Generate a random 32+ char string. Keep it secret and stable across restarts.
SETTINGS_ENCRYPTION_KEY=iran-behtar-default-encryption-key-v1

# Auth
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Node
NODE_ENV=production
PORT=3000
