# =============================================================================
# .env.example — template for runtime environment.
# Copy to `.env.production` on the server and fill in REAL values.
# This file is for REFERENCE ONLY. NEVER commit `.env.production` to git.
# =============================================================================

# ---- Database (SQLite) ----
# In Docker: points to the mounted volume (persists across rebuilds).
# On bare metal: use an absolute path on the host.
DATABASE_URL=file:/app/data/custom.db

# ---- Settings encryption key ----
# Used by src/lib/settings.ts to encrypt API keys stored in DB.
# MUST be a random 32+ character string. NEVER change after first deploy —
# changing it makes previously encrypted API keys unreadable.
# The server will REFUSE TO START if this is missing or too short.
# Generate one: openssl rand -base64 48
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARS

# ---- Auth ----
# Used by next-auth / session signing.
# Generate one: openssl rand -base64 48
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARS
# Public URL of the app (the one users see in the browser).
# Set to your real domain when deployed behind a reverse proxy.
NEXTAUTH_URL=http://localhost:3000

# ---- Node runtime ----
NODE_ENV=production
PORT=3000

# ---- Admin bootstrap (first deployment) ----
# On the FIRST `docker compose up`, the entrypoint creates this admin account
# automatically (idempotent — safe on every restart; password stays in sync).
# Leave empty to skip bootstrap and create the user manually.
ADMIN_EMAIL=mohammadtahaamiri@gmail.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_8_CHARS

# ---- OpenRouter AI settings (OPTIONAL — also configurable via admin UI) ----
# If you'd rather inject defaults via env instead of the admin panel:
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-or-v1-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL_CHAT=openai/gpt-4o-mini
# AI_MODEL_VISION=openai/gpt-4o
# AI_MODEL_ASR=openai/whisper-1
# AI_MODEL_TTS=openai/tts-1
